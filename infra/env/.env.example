# ==============================================================================
# Sentrix System Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Database Configuration
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (direct or pooled connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.unfmcryvabbuncsfyhvu.supabase.co:5432/postgres

# Supabase Project Base URL
SUPABASE_URL=https://unfmcryvabbuncsfyhvu.supabase.co

# Supabase Service Role Key (secret, administrative access for storage/backend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Object Storage bucket name for ML checkpoints
SUPABASE_STORAGE_BUCKET=sentrix-models

# ------------------------------------------------------------------------------
# Clerk Authentication Configuration
# ------------------------------------------------------------------------------
# Clerk Secret Key for backend authentication & webhook signature verification
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Signing Secret (from Clerk Webhook dashboard for user.created/updated sync)
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk JWKS Endpoint URL for session token JWT verification (e.g. https://clerk.your-domain.com/.well-known/jwks.json or https://api.clerk.com/v1/jwks)
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# ------------------------------------------------------------------------------
# Message Broker, Queue, and Cache
# ------------------------------------------------------------------------------
# Redis connection URL for Celery broker, Celery results backend, and WebSocket pub/sub
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Local LLM & SDN Controller
# ------------------------------------------------------------------------------
# Ollama local LLM service host
OLLAMA_HOST=http://ollama:11434

# Ryu SDN OpenFlow Controller REST API URL
RYU_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Clerk Publishable Key for client-side authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Next.js Clerk Sign-in and Sign-up route configurations
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Backend API base URL accessible from browser/client
NEXT_PUBLIC_API_URL=http://localhost:8000
